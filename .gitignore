*-profile/
profile-*/
user-data*/
.playwright*/

# Secrets and keys
.env*
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/

# Model weights (none ship with Sourced; shared weights live outside repos)
.models/
models/
*.onnx
*.safetensors
*.gguf
*.ckpt
*.pt

# Logs and editor or OS clutter
*.log
.DS_Store
.idea/
.vscode/
